{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-files",
    "name": "Prism File Browser",
    "version": "0.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3",
        "extensions": { "prism-core": ">=0.1.0" }
    },
    "description": "A better file manager: a VS Code style editor, tabs, a trash bin, bulk actions, previews and an upload queue.",
    "author": "Donkare",
    "icon": "folder-open",
    "provider": "PrismFiles\\PrismFilesProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "pfl",
        "views": [
            "page.server.files",
            "page.server.files.editor"
        ]
    }
}
