{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-branding",
    "name": "Prism Branding",
    "version": "0.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Your own favicon and logo: beside or instead of the company name, on the sign-in pages in place of the mascot, and a square logo for narrow sidebars.",
    "author": "Donkare",
    "icon": "image",
    "provider": "PrismBranding\\PrismBrandingProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "pbr",
        "views": [
            "layout.app"
        ]
    }
}
