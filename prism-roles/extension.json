{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-roles",
    "name": "Prism Roles",
    "version": "0.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3",
        "extensions": { "prism-core": ">=0.1.0" }
    },
    "description": "Reusable permission sets for subusers, such as Moderator, Builder and Viewer: pick one instead of ticking boxes, and change it once to update everyone who has it.",
    "author": "Donkare",
    "icon": "user-cog",
    "provider": "PrismRoles\\PrismRolesProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "prl",
        "screens": [
            {
                "id": "account-roles",
                "area": "account",
                "path": "subuser-roles",
                "nav": { "label": "Subuser roles", "icon": "user-cog" },
                "when": { "runtime": true }
            },
            {
                "id": "admin-roles",
                "area": "admin",
                "path": "subuser-roles",
                "nav": { "label": "Subuser roles", "icon": "user-cog" },
                "when": { "runtime": true }
            }
        ]
    }
}
