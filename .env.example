# Copy to .env and fill in. Scripts read it with: node --env-file=.env scripts/<script>.mjs

# Required: Portainer, which reaches the Panel container (deploy.mjs, run-php.mjs, portainer.mjs)
PORTAINER_URL=https://portainer.example.com
# Portainer > My account > Access tokens. It acts as its owner, so no username is needed.
PORTAINER_API_TOKEN=

# Optional: the Portainer environment id (default 2) and the Panel container's id or name
# PORTAINER_ENDPOINT=2
# PANEL_CONTAINER=

# Only for scripts/api.mjs: the Panel and a client API key
PANEL_URL=https://panel.example.com
MCS_KEY=ptlc_
