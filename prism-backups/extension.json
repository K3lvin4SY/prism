{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-backups",
    "name": "Prism Backups",
    "version": "0.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3",
        "extensions": { "prism-core": ">=0.1.0" }
    },
    "description": "Better backups: profiles that choose what is backed up, browsing inside a backup, restoring single files, and a .pteroignore editor with a path tester.",
    "author": "Donkare",
    "icon": "archive",
    "provider": "PrismBackups\\PrismBackupsProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "pbk",
        "views": [
            "server.backups"
        ]
    }
}
