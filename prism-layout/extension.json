{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-layout",
    "name": "Prism Layout",
    "version": "0.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Seven navigation layouts, server card styles, announcements, a Ctrl+K palette, your logo and favicon, and the sign-in page. Works with any theme.",
    "author": "Donkare",
    "icon": "layout-dashboard",
    "provider": "PrismLayout\\PrismLayoutProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "pla",
        "views": [
            "layout.app",
            "layout.server",
            "layout.account",
            "layout.admin",
            "dashboard.serverList",
            "dashboard.serverCard"
        ]
    }
}
