{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-themes",
    "type": "theme",
    "name": "Prism Themes",
    "version": "0.1.0",
    "description": "16 looks, 30 colours, light and dark, seven navigation layouts, seven server card styles, moving backgrounds, announcements and a Ctrl+K palette. Edit it live in Prism Properties.",
    "author": "Donkare",
    "icon": "palette",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0"
    },
    "ui": {
        "entry": "dist/client.js"
    },
    "theme": {
        "extends": "classic",
        "stylesheet": "dist/theme.css",
        "schemes": [
            "dark",
            "light"
        ],
        "settings": {
            "look": {
                "type": "select",
                "label": "Look",
                "help": "The finished design the rest builds on. Prism Properties sets the other settings to match when you pick one.",
                "tab": "Look",
                "options": {
                    "studio": "Studio",
                    "studio_classic": "Studio classic",
                    "rail": "Icon rail",
                    "wide": "Wide and grouped",
                    "command": "Command center",
                    "mono": "Monochrome",
                    "contrast": "High contrast",
                    "glass": "Glass",
                    "paper": "Paper",
                    "midnight": "Midnight",
                    "neon": "Neon",
                    "soft": "Soft",
                    "terminal": "Terminal",
                    "sunset": "Sunset",
                    "forest": "Forest",
                    "ocean": "Ocean",
                    "catppuccin": "Catppuccin",
                    "glassmorphism": "Glassmorphism"
                },
                "default": "studio",
                "attribute": "data-pt-look"
            },
            "palette": {
                "type": "select",
                "label": "Colour",
                "tab": "Colours",
                "options": {
                    "blue": "Blue",
                    "indigo": "Indigo",
                    "violet": "Violet",
                    "purple": "Purple",
                    "fuchsia": "Fuchsia",
                    "pink": "Pink",
                    "rose": "Rose",
                    "red": "Red",
                    "crimson": "Crimson",
                    "coral": "Coral",
                    "orange": "Orange",
                    "peach": "Peach",
                    "amber": "Amber",
                    "gold": "Gold",
                    "yellow": "Yellow",
                    "lime": "Lime",
                    "green": "Green",
                    "forest": "Forest",
                    "emerald": "Emerald",
                    "mint": "Mint",
                    "teal": "Teal",
                    "cyan": "Cyan",
                    "sky": "Sky",
                    "ocean": "Ocean",
                    "cobalt": "Cobalt",
                    "lavender": "Lavender",
                    "slate": "Slate",
                    "zinc": "Zinc",
                    "stone": "Stone",
                    "graphite": "Graphite",
                    "custom": "Custom"
                },
                "default": "blue",
                "attribute": "data-pt-palette"
            },
            "accent": {
                "type": "color",
                "label": "Custom colour",
                "help": "Used when the colour is Custom.",
                "tab": "Colours",
                "default": "#6366f1",
                "token": "--pt-accent"
            },
            "tint": {
                "type": "select",
                "label": "Tint the greys",
                "help": "How much of the colour the backgrounds and borders take on.",
                "tab": "Colours",
                "options": {
                    "none": "None",
                    "subtle": "Subtle",
                    "strong": "Strong"
                },
                "default": "subtle",
                "attribute": "data-pt-tint"
            },
            "scheme_switch": {
                "type": "toggle",
                "label": "Light and dark switch",
                "help": "Lets people pick light or dark for themselves.",
                "tab": "Colours",
                "default": true
            },
            "catppuccin": {
                "type": "toggle",
                "label": "Use Catppuccin",
                "help": "Catppuccin's official colours for every surface, text, the console and the editor, in place of the colour above.",
                "tab": "Catppuccin",
                "default": false,
                "attribute": "data-pt-ctp"
            },
            "catppuccin_flavor": {
                "type": "select",
                "label": "Flavour in dark mode",
                "help": "Light mode always uses Latte, the light flavour. Picking Latte here uses it in dark mode too.",
                "tab": "Catppuccin",
                "options": {
                    "latte": "Latte",
                    "frappe": "Frapp\u00e9",
                    "macchiato": "Macchiato",
                    "mocha": "Mocha"
                },
                "default": "mocha",
                "attribute": "data-pt-ctp-flavor"
            },
            "catppuccin_accent": {
                "type": "select",
                "label": "Accent",
                "tab": "Catppuccin",
                "options": {
                    "rosewater": "Rosewater",
                    "flamingo": "Flamingo",
                    "pink": "Pink",
                    "mauve": "Mauve",
                    "red": "Red",
                    "maroon": "Maroon",
                    "peach": "Peach",
                    "yellow": "Yellow",
                    "green": "Green",
                    "teal": "Teal",
                    "sky": "Sky",
                    "sapphire": "Sapphire",
                    "blue": "Blue",
                    "lavender": "Lavender"
                },
                "default": "mauve",
                "attribute": "data-pt-ctp-accent"
            },
            "bars": {
                "type": "select",
                "label": "Navigation",
                "tab": "Bars",
                "options": {
                    "sidebar": "Sidebar",
                    "top": "Top bar",
                    "dock": "Dock",
                    "sidebar_top": "Sidebar and top bar",
                    "rail": "Icon rail",
                    "rail_top": "Icon rail and top bar",
                    "top_dock": "Top bar and dock"
                },
                "default": "sidebar",
                "attribute": "data-pt-bars"
            },
            "sidebar_width": {
                "type": "number",
                "label": "Sidebar width",
                "tab": "Bars",
                "default": 16,
                "min": 12,
                "max": 22,
                "step": 1,
                "unit": "rem",
                "token": "--pt-sidebar-width"
            },
            "dock_magnify": {
                "type": "toggle",
                "label": "Dock icons grow under the pointer",
                "tab": "Bars",
                "default": true,
                "attribute": "data-pt-magnify"
            },
            "group_nav": {
                "type": "toggle",
                "label": "Group the server pages",
                "help": "Splits a server's pages into Manage, Files and data, and Configuration.",
                "tab": "Bars",
                "default": true
            },
            "server_card": {
                "type": "toggle",
                "label": "Server card in the sidebar",
                "help": "The open server's status and power buttons above its pages.",
                "tab": "Bars",
                "default": true
            },
            "cards": {
                "type": "select",
                "label": "Server cards",
                "tab": "Cards",
                "options": {
                    "banner": "Banner",
                    "tile": "Tile",
                    "neon": "Neon",
                    "minimal": "Minimal",
                    "compact": "Compact",
                    "outline": "Outline",
                    "rows": "Rows"
                },
                "default": "banner",
                "attribute": "data-pt-cards"
            },
            "status_style": {
                "type": "select",
                "label": "Status",
                "tab": "Cards",
                "options": {
                    "badge": "Badge",
                    "dot": "Dot",
                    "bar": "Coloured edge"
                },
                "default": "badge",
                "attribute": "data-pt-status"
            },
            "usage_style": {
                "type": "select",
                "label": "Usage",
                "tab": "Cards",
                "options": {
                    "bars": "Bars",
                    "numbers": "Numbers",
                    "hidden": "Hidden"
                },
                "default": "bars"
            },
            "egg_colors": {
                "type": "toggle",
                "label": "Colour cards by game",
                "help": "Each egg tag gets its own colour on the card.",
                "tab": "Cards",
                "default": true
            },
            "power_buttons": {
                "type": "toggle",
                "label": "Power buttons on cards",
                "tab": "Cards",
                "default": true
            },
            "card_image": {
                "type": "image",
                "label": "Card picture",
                "help": "Shown on Banner cards. Without one, a pattern in the game's colour.",
                "tab": "Cards",
                "token": "--pt-card-image"
            },
            "radius": {
                "type": "number",
                "label": "Corner rounding",
                "tab": "Shape",
                "default": 10,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "token": "--pt-radius"
            },
            "density": {
                "type": "select",
                "label": "Spacing",
                "tab": "Shape",
                "options": {
                    "compact": "Compact",
                    "cozy": "Cozy",
                    "comfortable": "Comfortable"
                },
                "default": "cozy",
                "attribute": "data-pt-density"
            },
            "width": {
                "type": "select",
                "label": "Page width",
                "tab": "Shape",
                "options": {
                    "normal": "Normal",
                    "wide": "Wide",
                    "full": "Full width"
                },
                "default": "normal",
                "attribute": "data-pt-width"
            },
            "font": {
                "type": "select",
                "label": "Font",
                "tab": "Shape",
                "options": {
                    "plex": "IBM Plex Sans",
                    "system": "System",
                    "rounded": "Rounded",
                    "serif": "Serif",
                    "mono": "Monospace"
                },
                "default": "plex",
                "attribute": "data-pt-font"
            },
            "font_size": {
                "type": "number",
                "label": "Text size",
                "tab": "Shape",
                "default": 16,
                "min": 13,
                "max": 18,
                "step": 1,
                "unit": "px",
                "token": "--pt-font-size"
            },
            "background": {
                "type": "select",
                "label": "Background",
                "tab": "Background",
                "options": {
                    "plain": "Plain",
                    "gradient": "Gradient",
                    "aurora": "Aurora (moving)",
                    "waves": "Waves (moving)",
                    "stars": "Stars (moving)",
                    "mesh": "Colour mesh (moving)",
                    "grid": "Grid",
                    "image": "Picture"
                },
                "default": "gradient",
                "attribute": "data-pt-bg"
            },
            "background_image": {
                "type": "image",
                "label": "Background picture",
                "help": "Used when the background is Picture.",
                "tab": "Background",
                "token": "--pt-bg-image"
            },
            "background_dim": {
                "type": "number",
                "label": "Darken the picture",
                "tab": "Background",
                "default": 55,
                "min": 0,
                "max": 95,
                "step": 5,
                "unit": "%",
                "token": "--pt-bg-dim"
            },
            "glass": {
                "type": "toggle",
                "label": "Glass panels",
                "help": "Cards and bars let the background show through, blurred.",
                "tab": "Background",
                "default": false,
                "attribute": "data-pt-glass"
            },
            "blur": {
                "type": "number",
                "label": "Glass blur",
                "tab": "Background",
                "default": 14,
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px",
                "token": "--pt-blur"
            },
            "motion": {
                "type": "select",
                "label": "Motion",
                "help": "People who ask their system for less motion always get it.",
                "tab": "Motion",
                "options": {
                    "full": "Full",
                    "reduced": "Reduced",
                    "none": "None"
                },
                "default": "full",
                "attribute": "data-pt-motion"
            },
            "announce_text": {
                "type": "text",
                "label": "Message",
                "help": "Empty shows no banner.",
                "tab": "Announcement",
                "default": "",
                "maxLength": 300
            },
            "announce_level": {
                "type": "select",
                "label": "Kind",
                "tab": "Announcement",
                "options": {
                    "info": "Information",
                    "success": "Good news",
                    "warning": "Warning",
                    "danger": "Problem"
                },
                "default": "info"
            },
            "announce_style": {
                "type": "select",
                "label": "Style",
                "tab": "Announcement",
                "options": {
                    "bar": "Bar across the top",
                    "card": "Card above the page"
                },
                "default": "bar"
            },
            "announce_audience": {
                "type": "select",
                "label": "Shown to",
                "tab": "Announcement",
                "options": {
                    "everyone": "Everyone",
                    "admins": "Administrators",
                    "users": "Everyone but administrators"
                },
                "default": "everyone"
            },
            "announce_link": {
                "type": "text",
                "label": "Button link",
                "tab": "Announcement",
                "default": "",
                "maxLength": 300
            },
            "announce_link_label": {
                "type": "text",
                "label": "Button text",
                "tab": "Announcement",
                "default": "Read more",
                "maxLength": 40
            },
            "announce_from": {
                "type": "text",
                "label": "Show from",
                "help": "A date and time such as 2026-11-01 08:00. Empty shows it now.",
                "tab": "Announcement",
                "default": "",
                "maxLength": 20
            },
            "announce_until": {
                "type": "text",
                "label": "Show until",
                "help": "Empty shows it until you clear the message.",
                "tab": "Announcement",
                "default": "",
                "maxLength": 20
            },
            "announce_dismiss": {
                "type": "toggle",
                "label": "People can close it",
                "help": "Closed stays closed in that browser until the message changes.",
                "tab": "Announcement",
                "default": true
            },
            "link1_label": {
                "type": "text",
                "label": "Link 1 text",
                "tab": "Links",
                "default": "",
                "maxLength": 40
            },
            "link1_url": {
                "type": "text",
                "label": "Link 1 address",
                "help": "Shown at the foot of the navigation, such as your Discord or store.",
                "tab": "Links",
                "default": "",
                "maxLength": 300
            },
            "link2_label": {
                "type": "text",
                "label": "Link 2 text",
                "tab": "Links",
                "default": "",
                "maxLength": 40
            },
            "link2_url": {
                "type": "text",
                "label": "Link 2 address",
                "tab": "Links",
                "default": "",
                "maxLength": 300
            },
            "link3_label": {
                "type": "text",
                "label": "Link 3 text",
                "tab": "Links",
                "default": "",
                "maxLength": 40
            },
            "link3_url": {
                "type": "text",
                "label": "Link 3 address",
                "tab": "Links",
                "default": "",
                "maxLength": 300
            },
            "login_style": {
                "type": "select",
                "label": "Sign-in page",
                "tab": "Sign-in",
                "options": {
                    "split": "Split with a picture",
                    "centered": "Centred card",
                    "classic": "The panel's own"
                },
                "default": "split",
                "attribute": "data-pt-login"
            },
            "login_tagline": {
                "type": "text",
                "label": "Tagline",
                "tab": "Sign-in",
                "default": "Your servers, in one place.",
                "maxLength": 120
            },
            "login_image": {
                "type": "image",
                "label": "Sign-in picture",
                "help": "The picture beside the form. Without one, the background.",
                "tab": "Sign-in",
                "token": "--pt-login-image"
            },
            "command_palette": {
                "type": "toggle",
                "label": "Ctrl+K command palette",
                "help": "Jump to any server, page or setting from the keyboard.",
                "tab": "Advanced",
                "default": true
            },
            "admin_styled": {
                "type": "toggle",
                "label": "Style the admin area",
                "help": "Off keeps the admin area in the panel's own layout.",
                "tab": "Advanced",
                "default": true
            }
        }
    }
}
