{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-themes",
    "type": "theme",
    "name": "Prism Themes",
    "version": "0.1.0",
    "description": "16 looks, 30 colours, Catppuccin, light and dark, fonts, glass and moving backgrounds. The layout is Prism Layout. Edit it live in Prism Properties.",
    "author": "Donkare",
    "icon": "palette",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0"
    },
    "ui": {
        "entry": "dist/client.js"
    },
    "theme": {
        "extends": "classic",
        "stylesheet": "dist/theme.css",
        "schemes": [
            "dark",
            "light"
        ],
        "settings": {
            "look": {
                "type": "select",
                "label": "Look",
                "help": "The finished design the rest builds on. Prism Properties sets the other settings to match when you pick one.",
                "tab": "Look",
                "options": {
                    "studio": "Studio",
                    "studio_classic": "Studio classic",
                    "rail": "Icon rail",
                    "wide": "Wide and grouped",
                    "command": "Command center",
                    "mono": "Monochrome",
                    "contrast": "High contrast",
                    "glass": "Glass",
                    "paper": "Paper",
                    "midnight": "Midnight",
                    "neon": "Neon",
                    "soft": "Soft",
                    "terminal": "Terminal",
                    "sunset": "Sunset",
                    "forest": "Forest",
                    "ocean": "Ocean",
                    "catppuccin": "Catppuccin",
                    "glassmorphism": "Glassmorphism"
                },
                "default": "studio",
                "attribute": "data-pt-look"
            },
            "palette": {
                "type": "select",
                "label": "Colour",
                "tab": "Colours",
                "options": {
                    "blue": "Blue",
                    "indigo": "Indigo",
                    "violet": "Violet",
                    "purple": "Purple",
                    "fuchsia": "Fuchsia",
                    "pink": "Pink",
                    "rose": "Rose",
                    "red": "Red",
                    "crimson": "Crimson",
                    "coral": "Coral",
                    "orange": "Orange",
                    "peach": "Peach",
                    "amber": "Amber",
                    "gold": "Gold",
                    "yellow": "Yellow",
                    "lime": "Lime",
                    "green": "Green",
                    "forest": "Forest",
                    "emerald": "Emerald",
                    "mint": "Mint",
                    "teal": "Teal",
                    "cyan": "Cyan",
                    "sky": "Sky",
                    "ocean": "Ocean",
                    "cobalt": "Cobalt",
                    "lavender": "Lavender",
                    "slate": "Slate",
                    "zinc": "Zinc",
                    "stone": "Stone",
                    "graphite": "Graphite",
                    "custom": "Custom"
                },
                "default": "blue",
                "attribute": "data-pt-palette"
            },
            "accent": {
                "type": "color",
                "label": "Custom colour",
                "help": "Used when the colour is Custom.",
                "tab": "Colours",
                "default": "#6366f1",
                "token": "--pt-accent"
            },
            "tint": {
                "type": "select",
                "label": "Tint the greys",
                "help": "How much of the colour the backgrounds and borders take on.",
                "tab": "Colours",
                "options": {
                    "none": "None",
                    "subtle": "Subtle",
                    "strong": "Strong"
                },
                "default": "subtle",
                "attribute": "data-pt-tint"
            },
            "catppuccin": {
                "type": "toggle",
                "label": "Use Catppuccin",
                "help": "Catppuccin's official colours for every surface, text, the console and the editor, in place of the colour above.",
                "tab": "Catppuccin",
                "default": false,
                "attribute": "data-pt-ctp"
            },
            "catppuccin_flavor": {
                "type": "select",
                "label": "Flavour in dark mode",
                "help": "Light mode always uses Latte, the light flavour. Picking Latte here uses it in dark mode too.",
                "tab": "Catppuccin",
                "options": {
                    "latte": "Latte",
                    "frappe": "Frapp\u00e9",
                    "macchiato": "Macchiato",
                    "mocha": "Mocha"
                },
                "default": "mocha",
                "attribute": "data-pt-ctp-flavor"
            },
            "catppuccin_accent": {
                "type": "select",
                "label": "Accent",
                "tab": "Catppuccin",
                "options": {
                    "rosewater": "Rosewater",
                    "flamingo": "Flamingo",
                    "pink": "Pink",
                    "mauve": "Mauve",
                    "red": "Red",
                    "maroon": "Maroon",
                    "peach": "Peach",
                    "yellow": "Yellow",
                    "green": "Green",
                    "teal": "Teal",
                    "sky": "Sky",
                    "sapphire": "Sapphire",
                    "blue": "Blue",
                    "lavender": "Lavender"
                },
                "default": "mauve",
                "attribute": "data-pt-ctp-accent"
            },
            "radius": {
                "type": "number",
                "label": "Corner rounding",
                "tab": "Shape",
                "default": 10,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "token": "--pt-radius"
            },
            "font": {
                "type": "select",
                "label": "Font",
                "tab": "Shape",
                "options": {
                    "plex": "IBM Plex Sans",
                    "system": "System",
                    "rounded": "Rounded",
                    "serif": "Serif",
                    "mono": "Monospace"
                },
                "default": "plex",
                "attribute": "data-pt-font"
            },
            "font_size": {
                "type": "number",
                "label": "Text size",
                "tab": "Shape",
                "default": 16,
                "min": 13,
                "max": 18,
                "step": 1,
                "unit": "px",
                "token": "--pt-font-size"
            },
            "background": {
                "type": "select",
                "label": "Background",
                "tab": "Background",
                "options": {
                    "plain": "Plain",
                    "gradient": "Gradient",
                    "aurora": "Aurora (moving)",
                    "waves": "Waves (moving)",
                    "stars": "Stars (moving)",
                    "mesh": "Colour mesh (moving)",
                    "grid": "Grid",
                    "image": "Picture"
                },
                "default": "gradient",
                "attribute": "data-pt-bg"
            },
            "background_image": {
                "type": "image",
                "label": "Background picture",
                "help": "Used when the background is Picture.",
                "tab": "Background",
                "token": "--pt-bg-image"
            },
            "background_dim": {
                "type": "number",
                "label": "Darken the picture",
                "tab": "Background",
                "default": 55,
                "min": 0,
                "max": 95,
                "step": 5,
                "unit": "%",
                "token": "--pt-bg-dim"
            },
            "glass": {
                "type": "toggle",
                "label": "Glass panels",
                "help": "Cards and bars let the background show through, blurred.",
                "tab": "Background",
                "default": false,
                "attribute": "data-pt-glass"
            },
            "blur": {
                "type": "number",
                "label": "Glass blur",
                "tab": "Background",
                "default": 14,
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px",
                "token": "--pt-blur"
            },
            "motion": {
                "type": "select",
                "label": "Motion",
                "help": "People who ask their system for less motion always get it.",
                "tab": "Motion",
                "options": {
                    "full": "Full",
                    "reduced": "Reduced",
                    "none": "None"
                },
                "default": "full",
                "attribute": "data-pt-motion"
            }
        }
    }
}
