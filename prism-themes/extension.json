{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-themes",
    "type": "theme",
    "name": "Prism Themes",
    "version": "0.2.0",
    "description": "One theme tool: colors for dark and light, type and shape, surfaces, backgrounds and motion, with built-in presets such as Catppuccin and your own. The layout is Prism Layout.",
    "author": "Donkare",
    "icon": "icon.png",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "extensions": {
            "prism-core": ">=0.1.0"
        }
    },
    "ui": {
        "entry": "dist/client.js"
    },
    "theme": {
        "extends": "classic",
        "stylesheet": "dist/theme.css",
        "schemes": [
            "dark",
            "light"
        ],
        "settings": {
            "d_background": {
                "type": "color",
                "label": "Background (dark)",
                "help": "Behind everything.",
                "tab": "Dark colors",
                "default": "#1a2340",
                "token": "--pt-d-background"
            },
            "d_surface": {
                "type": "color",
                "label": "Cards (dark)",
                "help": "Cards, panels and dialogs.",
                "tab": "Dark colors",
                "default": "#0d111f",
                "token": "--pt-d-surface"
            },
            "d_sidebar": {
                "type": "color",
                "label": "Sidebar and bars (dark)",
                "help": "The navigation and top bars.",
                "tab": "Dark colors",
                "default": "#121830",
                "token": "--pt-d-sidebar"
            },
            "d_raised": {
                "type": "color",
                "label": "Raised (dark)",
                "help": "Menus, hovered rows and quiet fills.",
                "tab": "Dark colors",
                "default": "#222b4d",
                "token": "--pt-d-raised"
            },
            "d_deep": {
                "type": "color",
                "label": "Deep (dark)",
                "help": "Wells: the console, code and sunken areas.",
                "tab": "Dark colors",
                "default": "#0a0d18",
                "token": "--pt-d-deep"
            },
            "d_border": {
                "type": "color",
                "label": "Borders (dark)",
                "help": "Lines between things.",
                "tab": "Dark colors",
                "default": "#2c355a",
                "token": "--pt-d-border"
            },
            "d_text": {
                "type": "color",
                "label": "Text (dark)",
                "tab": "Dark colors",
                "default": "#f5f7ff",
                "token": "--pt-d-text"
            },
            "d_muted_text": {
                "type": "color",
                "label": "Quiet text (dark)",
                "help": "Descriptions and hints.",
                "tab": "Dark colors",
                "default": "#aeb7d9",
                "token": "--pt-d-muted-text"
            },
            "d_primary": {
                "type": "color",
                "label": "Primary (dark)",
                "help": "Buttons, links, the active page.",
                "tab": "Dark colors",
                "default": "#98adfe",
                "token": "--pt-d-primary"
            },
            "d_on_primary": {
                "type": "color",
                "label": "Text on color (dark)",
                "help": "Text on primary and the status colors.",
                "tab": "Dark colors",
                "default": "#0d111f",
                "token": "--pt-d-on-primary"
            },
            "d_success": {
                "type": "color",
                "label": "Success (dark)",
                "tab": "Dark colors",
                "default": "#4ade80",
                "token": "--pt-d-success"
            },
            "d_warning": {
                "type": "color",
                "label": "Warning (dark)",
                "tab": "Dark colors",
                "default": "#fcc864",
                "token": "--pt-d-warning"
            },
            "d_danger": {
                "type": "color",
                "label": "Danger (dark)",
                "tab": "Dark colors",
                "default": "#ff6b81",
                "token": "--pt-d-danger"
            },
            "d_red": {
                "type": "color",
                "label": "Red (dark)",
                "help": "Errors in the console.",
                "tab": "Dark colors",
                "default": "#ff6b81",
                "token": "--pt-d-red"
            },
            "d_green": {
                "type": "color",
                "label": "Green (dark)",
                "help": "Strings and good news.",
                "tab": "Dark colors",
                "default": "#4ade80",
                "token": "--pt-d-green"
            },
            "d_yellow": {
                "type": "color",
                "label": "Yellow (dark)",
                "help": "Types and warnings.",
                "tab": "Dark colors",
                "default": "#fcc864",
                "token": "--pt-d-yellow"
            },
            "d_blue": {
                "type": "color",
                "label": "Blue (dark)",
                "help": "Functions.",
                "tab": "Dark colors",
                "default": "#98adfe",
                "token": "--pt-d-blue"
            },
            "d_magenta": {
                "type": "color",
                "label": "Magenta (dark)",
                "help": "Keywords.",
                "tab": "Dark colors",
                "default": "#d6a4ff",
                "token": "--pt-d-magenta"
            },
            "d_cyan": {
                "type": "color",
                "label": "Cyan (dark)",
                "help": "Operators and info.",
                "tab": "Dark colors",
                "default": "#67e8f9",
                "token": "--pt-d-cyan"
            },
            "l_background": {
                "type": "color",
                "label": "Background (light)",
                "help": "Behind everything.",
                "tab": "Light colors",
                "default": "#eef1fb",
                "token": "--pt-l-background"
            },
            "l_surface": {
                "type": "color",
                "label": "Cards (light)",
                "help": "Cards, panels and dialogs.",
                "tab": "Light colors",
                "default": "#ffffff",
                "token": "--pt-l-surface"
            },
            "l_sidebar": {
                "type": "color",
                "label": "Sidebar and bars (light)",
                "help": "The navigation and top bars.",
                "tab": "Light colors",
                "default": "#e5e9f8",
                "token": "--pt-l-sidebar"
            },
            "l_raised": {
                "type": "color",
                "label": "Raised (light)",
                "help": "Menus, hovered rows and quiet fills.",
                "tab": "Light colors",
                "default": "#e3e8f8",
                "token": "--pt-l-raised"
            },
            "l_deep": {
                "type": "color",
                "label": "Deep (light)",
                "help": "Wells: the console, code and sunken areas.",
                "tab": "Light colors",
                "default": "#dfe4f5",
                "token": "--pt-l-deep"
            },
            "l_border": {
                "type": "color",
                "label": "Borders (light)",
                "help": "Lines between things.",
                "tab": "Light colors",
                "default": "#cfd6ef",
                "token": "--pt-l-border"
            },
            "l_text": {
                "type": "color",
                "label": "Text (light)",
                "tab": "Light colors",
                "default": "#141a33",
                "token": "--pt-l-text"
            },
            "l_muted_text": {
                "type": "color",
                "label": "Quiet text (light)",
                "help": "Descriptions and hints.",
                "tab": "Light colors",
                "default": "#5b6488",
                "token": "--pt-l-muted-text"
            },
            "l_primary": {
                "type": "color",
                "label": "Primary (light)",
                "help": "Buttons, links, the active page.",
                "tab": "Light colors",
                "default": "#4f63d8",
                "token": "--pt-l-primary"
            },
            "l_on_primary": {
                "type": "color",
                "label": "Text on color (light)",
                "help": "Text on primary and the status colors.",
                "tab": "Light colors",
                "default": "#ffffff",
                "token": "--pt-l-on-primary"
            },
            "l_success": {
                "type": "color",
                "label": "Success (light)",
                "tab": "Light colors",
                "default": "#15934a",
                "token": "--pt-l-success"
            },
            "l_warning": {
                "type": "color",
                "label": "Warning (light)",
                "tab": "Light colors",
                "default": "#b7791f",
                "token": "--pt-l-warning"
            },
            "l_danger": {
                "type": "color",
                "label": "Danger (light)",
                "tab": "Light colors",
                "default": "#d23a55",
                "token": "--pt-l-danger"
            },
            "l_red": {
                "type": "color",
                "label": "Red (light)",
                "help": "Errors in the console.",
                "tab": "Light colors",
                "default": "#d23a55",
                "token": "--pt-l-red"
            },
            "l_green": {
                "type": "color",
                "label": "Green (light)",
                "help": "Strings and good news.",
                "tab": "Light colors",
                "default": "#15934a",
                "token": "--pt-l-green"
            },
            "l_yellow": {
                "type": "color",
                "label": "Yellow (light)",
                "help": "Types and warnings.",
                "tab": "Light colors",
                "default": "#a16207",
                "token": "--pt-l-yellow"
            },
            "l_blue": {
                "type": "color",
                "label": "Blue (light)",
                "help": "Functions.",
                "tab": "Light colors",
                "default": "#4f63d8",
                "token": "--pt-l-blue"
            },
            "l_magenta": {
                "type": "color",
                "label": "Magenta (light)",
                "help": "Keywords.",
                "tab": "Light colors",
                "default": "#9b4fd8",
                "token": "--pt-l-magenta"
            },
            "l_cyan": {
                "type": "color",
                "label": "Cyan (light)",
                "help": "Operators and info.",
                "tab": "Light colors",
                "default": "#0e7490",
                "token": "--pt-l-cyan"
            },
            "radius": {
                "type": "number",
                "label": "Corner rounding",
                "tab": "Type and shape",
                "default": 14,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "token": "--pt-radius"
            },
            "font": {
                "type": "select",
                "label": "Font",
                "tab": "Type and shape",
                "options": {
                    "plex": "IBM Plex Sans",
                    "inter": "Inter",
                    "system": "System",
                    "rounded": "Rounded",
                    "serif": "Serif",
                    "mono": "Monospace"
                },
                "default": "inter",
                "attribute": "data-pt-font"
            },
            "labels": {
                "type": "select",
                "label": "Small labels",
                "help": "Headings in capitals, such as the groups of the Ctrl+K search and the badges: in the text font or in monospace.",
                "tab": "Type and shape",
                "options": {
                    "sans": "Like the text",
                    "mono": "Monospace"
                },
                "default": "mono",
                "attribute": "data-pt-labels"
            },
            "font_size": {
                "type": "number",
                "label": "Text size",
                "tab": "Type and shape",
                "default": 16,
                "min": 13,
                "max": 18,
                "step": 1,
                "unit": "px",
                "token": "--pt-font-size"
            },
            "switches": {
                "type": "select",
                "label": "Switches",
                "help": "The shape of every Prism switch, such as Files, Editor and Trash. Square follows the corner rounding.",
                "tab": "Type and shape",
                "options": {
                    "rounded": "Rounded",
                    "square": "Square"
                },
                "default": "rounded",
                "attribute": "data-pt-switches"
            },
            "surface_style": {
                "type": "select",
                "label": "Cards and bars",
                "help": "How cards, menus and bars stand out from the background.",
                "tab": "Surfaces",
                "options": {
                    "flat": "Flat",
                    "raised": "Soft shadow",
                    "outlined": "Outlined",
                    "glow": "Glow",
                    "glass": "Glass"
                },
                "default": "raised",
                "attribute": "data-pt-surface"
            },
            "blur": {
                "type": "number",
                "label": "Glass blur",
                "help": "For Glass.",
                "tab": "Surfaces",
                "default": 14,
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px",
                "token": "--pt-blur"
            },
            "opacity": {
                "type": "number",
                "label": "Glass solidity",
                "help": "For Glass: how much of the card color covers what is behind.",
                "tab": "Surfaces",
                "default": 70,
                "min": 30,
                "max": 100,
                "step": 5,
                "unit": "%",
                "token": "--pt-opacity"
            },
            "background": {
                "type": "select",
                "label": "Background",
                "tab": "Background",
                "options": {
                    "plain": "Plain",
                    "gradient": "Gradient",
                    "aurora": "Aurora (moving)",
                    "waves": "Waves (moving)",
                    "stars": "Stars (moving)",
                    "mesh": "Color mesh (moving)",
                    "grid": "Grid",
                    "image": "Picture"
                },
                "default": "plain",
                "attribute": "data-pt-bg"
            },
            "background_image": {
                "type": "image",
                "label": "Background picture",
                "help": "Used when the background is Picture.",
                "tab": "Background",
                "token": "--pt-bg-image"
            },
            "background_dim": {
                "type": "number",
                "label": "Darken the picture",
                "tab": "Background",
                "default": 55,
                "min": 0,
                "max": 95,
                "step": 5,
                "unit": "%",
                "token": "--pt-bg-dim"
            },
            "motion": {
                "type": "select",
                "label": "Motion",
                "help": "People who ask their system for less motion always get it.",
                "tab": "Motion",
                "options": {
                    "full": "Full",
                    "reduced": "Reduced",
                    "none": "None"
                },
                "default": "full",
                "attribute": "data-pt-motion"
            },
            "preset": {
                "type": "text",
                "label": "Preset",
                "help": "The preset these values came from.",
                "tab": "Presets",
                "default": "Prism Slate",
                "maxLength": 80
            },
            "presets": {
                "type": "text",
                "label": "Your presets",
                "help": "Presets made in Prism Properties.",
                "tab": "Presets",
                "default": "[{\"id\":\"own-mvmql8vx-p3cv\",\"name\":\"Catppuccin Mocha Blue\",\"values\":{\"d_background\":\"#1e1e2e\",\"d_surface\":\"#181825\",\"d_sidebar\":\"#11111b\",\"d_raised\":\"#313244\",\"d_deep\":\"#11111b\",\"d_border\":\"#313244\",\"d_text\":\"#cdd6f4\",\"d_muted_text\":\"#a6adc8\",\"d_primary\":\"#cba6f7\",\"d_on_primary\":\"#11111b\",\"d_success\":\"#a6e3a1\",\"d_warning\":\"#f9e2af\",\"d_danger\":\"#f38ba8\",\"d_red\":\"#f38ba8\",\"d_green\":\"#a6e3a1\",\"d_yellow\":\"#f9e2af\",\"d_blue\":\"#89b4fa\",\"d_magenta\":\"#f5c2e7\",\"d_cyan\":\"#94e2d5\",\"l_background\":\"#eff1f5\",\"l_surface\":\"#e6e9ef\",\"l_sidebar\":\"#dce0e8\",\"l_raised\":\"#ccd0da\",\"l_deep\":\"#dce0e8\",\"l_border\":\"#ccd0da\",\"l_text\":\"#4c4f69\",\"l_muted_text\":\"#6c6f85\",\"l_primary\":\"#8839ef\",\"l_on_primary\":\"#dce0e8\",\"l_success\":\"#40a02b\",\"l_warning\":\"#df8e1d\",\"l_danger\":\"#d20f39\",\"l_red\":\"#d20f39\",\"l_green\":\"#40a02b\",\"l_yellow\":\"#df8e1d\",\"l_blue\":\"#1e66f5\",\"l_magenta\":\"#ea76cb\",\"l_cyan\":\"#179299\",\"radius\":12,\"font\":\"plex\",\"font_size\":16,\"switches\":\"rounded\",\"surface_style\":\"flat\",\"blur\":14,\"opacity\":70,\"background\":\"plain\",\"background_dim\":55,\"motion\":\"full\"}}]",
                "maxLength": 200000
            }
        }
    }
}
