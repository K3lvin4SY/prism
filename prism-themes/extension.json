{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-themes",
    "type": "theme",
    "name": "Prism Themes",
    "version": "0.2.0",
    "description": "One theme tool: colours for dark and light, type and shape, surfaces, backgrounds and motion, with built-in presets such as Catppuccin and your own. The layout is Prism Layout.",
    "author": "Donkare",
    "icon": "palette",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0"
    },
    "ui": {
        "entry": "dist/client.js"
    },
    "theme": {
        "extends": "classic",
        "stylesheet": "dist/theme.css",
        "schemes": [
            "dark",
            "light"
        ],
        "settings": {
            "d_background": {
                "type": "color",
                "label": "Background (dark)",
                "help": "Behind everything.",
                "tab": "Dark colours",
                "default": "oklch(0.165 0.0204 255)",
                "token": "--pt-d-background"
            },
            "d_surface": {
                "type": "color",
                "label": "Cards (dark)",
                "help": "Cards, panels and dialogs.",
                "tab": "Dark colours",
                "default": "oklch(0.205 0.0204 255)",
                "token": "--pt-d-surface"
            },
            "d_sidebar": {
                "type": "color",
