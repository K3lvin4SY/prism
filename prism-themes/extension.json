                "help": "Operators and info.",
                "tab": "Light colours",
                "default": "oklch(0.58 0.1 200)",
                "token": "--pt-l-cyan"
            },
            "radius": {
                "type": "number",
                "label": "Corner rounding",
                "tab": "Type and shape",
                "default": 10,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "token": "--pt-radius"
            },
            "font": {
                "type": "select",
                "label": "Font",
                "tab": "Type and shape",
                "options": {
                    "plex": "IBM Plex Sans",
                    "system": "System",
                    "rounded": "Rounded",
                    "serif": "Serif",
                    "mono": "Monospace"
                },
                "default": "plex",
                "attribute": "data-pt-font"
            },
            "font_size": {
                "type": "number",
                "label": "Text size",
                "tab": "Type and shape",
                "default": 16,
                "min": 13,
                "max": 18,
                "step": 1,
                "unit": "px",
                "token": "--pt-font-size"
            },
            "switches": {
                "type": "select",
                "label": "Switches",
                "help": "The shape of every Prism switch, such as Files, Editor and Trash. Square follows the corner rounding.",
                "tab": "Type and shape",
                "options": {
                    "rounded": "Rounded",
                    "square": "Square"
                },
                "default": "rounded",
                "attribute": "data-pt-switches"
            },
            "surface_style": {
                "type": "select",
                "label": "Cards and bars",
                "help": "How cards, menus and bars stand out from the background.",
                "tab": "Surfaces",
                "options": {
                    "flat": "Flat",
                    "raised": "Soft shadow",
                    "outlined": "Outlined",
                    "glow": "Glow",
                    "glass": "Glass"
                },
                "default": "raised",
                "attribute": "data-pt-surface"
            },
            "blur": {
                "type": "number",
                "label": "Glass blur",
                "help": "For Glass.",
                "tab": "Surfaces",
                "default": 14,
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px",
                "token": "--pt-blur"
            },
            "opacity": {
                "type": "number",
                "label": "Glass solidity",
                "help": "For Glass: how much of the card colour covers what is behind.",
                "tab": "Surfaces",
                "default": 70,
                "min": 30,
                "max": 100,
                "step": 5,
                "unit": "%",
                "token": "--pt-opacity"
            },
            "background": {
                "type": "select",
                "label": "Background",
                "tab": "Background",
                "options": {
                    "plain": "Plain",
                    "gradient": "Gradient",
                    "aurora": "Aurora (moving)",
                    "waves": "Waves (moving)",
                    "stars": "Stars (moving)",
                    "mesh": "Colour mesh (moving)",
                    "grid": "Grid",
                    "image": "Picture"
                },
                "default": "gradient",
                "attribute": "data-pt-bg"
            },
            "background_image": {
                "type": "image",
                "label": "Background picture",
                "help": "Used when the background is Picture.",
                "tab": "Background",
                "token": "--pt-bg-image"
            },
            "background_dim": {
                "type": "number",
                "label": "Darken the picture",
                "tab": "Background",
                "default": 55,
                "min": 0,
                "max": 95,
                "step": 5,
                "unit": "%",
                "token": "--pt-bg-dim"
            },
            "motion": {
                "type": "select",
                "label": "Motion",
                "help": "People who ask their system for less motion always get it.",
                "tab": "Motion",
                "options": {
                    "full": "Full",
                    "reduced": "Reduced",
                    "none": "None"
                },
                "default": "full",
                "attribute": "data-pt-motion"
            },
            "preset": {
                "type": "text",
                "label": "Preset",
                "help": "The preset these values came from.",
                "tab": "Presets",
                "default": "Studio",
                "maxLength": 80
            },
            "presets": {
                "type": "text",
                "label": "Your presets",
                "help": "Presets made in Prism Properties.",
                "tab": "Presets",
                "default": "[]",
                "maxLength": 200000
            }
