{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "prism-nodes",
    "name": "Prism Nodes",
    "version": "0.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3",
        "extensions": { "prism-core": ">=0.1.0" }
    },
    "description": "A health page for your nodes: Wings version and updates, host and server usage with history, maintenance mode, and moving servers to another node one at a time.",
    "author": "Donkare",
    "icon": "server",
    "provider": "PrismNodes\\PrismNodesProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "pnd",
        "screens": [
            {
                "id": "admin-nodes",
                "area": "admin",
                "path": "node-health",
                "nav": { "label": "Node health", "icon": "activity" },
                "when": { "runtime": true }
            }
        ]
    }
}
